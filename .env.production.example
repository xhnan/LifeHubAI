# 生产环境配置模板
# 复制此文件为 .env.production 并填写实际配置值

# 环境配置
ENVIRONMENT=production

# Nacos 配置
NACOS_ENABLED=true
NACOS_SERVER_ADDRESSES=your-nacos-server:8848
NACOS_NAMESPACE=public
NACOS_CONFIG_DATA_ID=lifehubai
NACOS_CONFIG_GROUP=DEFAULT_GROUP
NACOS_USERNAME=nacos
NACOS_PASSWORD=your-nacos-password

# 数据库配置（会被 Nacos 覆盖，这里作为默认值）
DB_HOST=your-production-host
DB_PORT=5432
DB_NAME=LifeHub
DB_USER=your-user
DB_PASSWORD=your-password

# AI 配置
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_API_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 代码生成配置
CODE_OUTPUT_DIR=/app/generated
CODE_PACKAGE_PREFIX=com.xhn

# Nacos 服务注册配置
NACOS_SERVICE_NAME=lifehubai
# NACOS_SERVICE_IP=     # 可选，不填则自动获取容器 IP
