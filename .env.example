# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_database
DB_USER=your_username
DB_PASSWORD=your_password

# AI Configuration
AI_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
# 或者使用 API_KEY（二选一即可）
# API_KEY=your_deepseek_api_key

# LLM 模型配置
LLM_MODEL=deepseek-chat

# Zhipu AI TTS Configuration
ZHIPU_API_KEY=your_zhipu_api_key

# gRPC Server Configuration
GRPC_SERVER_HOST=0.0.0.0
GRPC_SERVER_PORT=50051
GRPC_MAX_WORKERS=10
GRPC_ENABLED=true

# FastAPI Server Configuration
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000

# Code Generation Configuration
# Java 项目根目录（生成的代码将写入此目录）
# Windows 示例: D:/Code/MyJavaProject
# Linux/Mac 示例: /home/user/myproject
CODE_OUTPUT_DIR=./output
# Java 包名前缀
CODE_PACKAGE_PREFIX=com.xhn

# Health Agent Configuration (optional, falls back to general config)
HEALTH_LLM_MODEL=deepseek-chat
HEALTH_LLM_BASE_URL=https://api.deepseek.com/v1
HEALTH_LLM_API_KEY=

# Finance Agent Configuration (optional, falls back to Health agent config)
FINANCE_LLM_MODEL=deepseek-chat
FINANCE_LLM_BASE_URL=https://api.deepseek.com/v1
FINANCE_LLM_API_KEY=
